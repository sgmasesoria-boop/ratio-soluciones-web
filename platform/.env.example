# Inventory only: no real values and no automatic loading by Node scripts.
# Offline builds and QA need none of the service credentials below.

# Local browser executable override; leave blank for installed Edge/Chromium.
CHROME_PATH=
# Compatible PostgreSQL bin directory, needed only for real database backup.
RATIO_POSTGRES_BIN=

# Supabase server configuration. Never expose service-role keys in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Allowed frontend origins and invitation/reset destination.
ALLOWED_WEB_ORIGINS=
CLIENT_PORTAL_URL=

# Contract identity: all three required before generating any draft PDF.
RATIO_CONTRACT_ISSUER_NAME=
RATIO_CONTRACT_ISSUER_IDENTIFIER=
RATIO_CONTRACT_ISSUER_ADDRESS=
# Reply mailbox required before sending a contract.
RATIO_CONTRACT_REPLY_TO=
# Set true only after independent legal validation; blank is unvalidated.
CONTRACT_TEMPLATE_VALIDATED=
# External signature provider: configure separately; never used in offline QA.
SIGNATURIT_ACCESS_TOKEN=
SIGNATURIT_EVENTS_URL=
SIGNATURIT_MODE=

# SMTP server, credentials and public/internal notification recipients.
RATIO_SMTP_HOST=
RATIO_SMTP_PORT=
RATIO_SMTP_USER=
RATIO_SMTP_PASSWORD=
RATIO_NOTIFICATION_EMAIL=
RATIO_INTERNAL_NOTIFICATION_EMAIL=

# AI service and model selection; external calls can incur cost.
OPENAI_API_KEY=
OPENAI_TRIAGE_MODEL=
OPENAI_PROFESSIONAL_MODEL=
OPENAI_DOCUMENT_INDEX_MODEL=
# Optional kill switch for document analysis.
OPENAI_DOCUMENT_ANALYSIS_DISABLED=
# Usage budget and cost estimates; configure using current provider pricing.
OPENAI_MONTHLY_HARD_LIMIT_USD=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
OPENAI_PROFESSIONAL_INPUT_USD_PER_MILLION=
OPENAI_PROFESSIONAL_OUTPUT_USD_PER_MILLION=

# Real backup tools only; no real values belong in this file or the repository.
RATIO_SUPABASE_URL=
RATIO_SUPABASE_SERVICE_ROLE_KEY=
RATIO_BACKUP_PASSPHRASE=
# PGPASSWORD is populated transiently by the database assistant and cleared.
# Do not persist it in .env. PATH, ProgramFiles and OneDrive are OS variables.
